{
  "name": "whiskerwood-mcp",
  "version": "0.1.0",
  "description": "MCP server for modding Whiskerwood (Unreal Engine 5.6) with UE4SS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MirakuruRR/WhiskerWood_MCP.git"
  },
  "homepage": "https://github.com/MirakuruRR/WhiskerWood_MCP#readme",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "setup": "bun run src/scripts/setup.ts",
    "doctor": "bun run src/scripts/doctor.ts",
    "dumps:pull": "bun run src/scripts/pull-dumps.ts",
    "serve": "bun run src/stdio.ts",
    "bridge:deploy": "bun run src/scripts/deploy-bridge.ts",
    "smoke": "bun run src/scripts/smoke-client.ts",
    "memory:export": "bun run src/scripts/memory-export.ts",
    "memory:sync": "bun run src/scripts/memory-sync.ts",
    "ue4ss-sdk": "bun run src/scripts/ue4ss-sdk.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@types/luaparse": "^0.2.13",
    "luaparse": "^0.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
